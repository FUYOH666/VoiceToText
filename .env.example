# Copy to .env.local (gitignored) — never commit real hosts or tokens

# Active profile override (optional; default in config.yaml)
# VTT2_PROFILE=mac-m1-remote

# Private ASR server (required for mac-*-remote and linux-f9-edge)
LOCAL_AI_ASR_BASE_URL=http://YOUR_TAILSCALE_HOST:8001
LOCAL_AI_ASR_TIMEOUT=60
LOCAL_AI_ASR_DEFAULT_LANGUAGE=auto

# VTT2 overrides (optional)
# VTT2_UI_HOTKEY=option+space
# VTT2_AUDIO_MAX_RECORDING_DURATION=7200
