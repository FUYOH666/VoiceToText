# VTT-MLX-M4 Configuration Example
# Copy to .env.vtt2 (gitignored) for LaunchAgent EnvironmentVariables

# Menubar should use local_stt (HTTP → ai.vtt2.stt). Do not force mlx_whisper
# in the UI agent env or you load a second copy of the model.
# VTT2_TRANSCRIPTION_ENGINE=local_stt

# Optional overrides (simple keys work best with current ENV mapper):
# VTT2_TRANSCRIPTION_ENGINE=local_stt
# VTT2_AUDIO_MAX_RECORDING_DURATION=7200
# VTT2_PERFORMANCE_MEMORY_LIMIT_MB=16384

# Remote ASR (Tailscale) — only if transcription.engine=remote_asr
# LOCAL_AI_ASR_BASE_URL=http://YOUR_TAILSCALE_IP:8001
# LOCAL_AI_ASR_TIMEOUT=60

