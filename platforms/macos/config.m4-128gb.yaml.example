# VTTv2 Configuration - MacBook Pro M4 (128GB RAM)

# ⭐ Оптимизировано для MacBook Pro M4 с 128GB RAM
# Использует MLX Whisper с моделью Large V3 для максимальной точности

app:
  version: "1.0.0"
  name: "VTTv2"

# ⭐ Движок транскрипции - MLX Whisper (оптимизировано для Apple Silicon)
transcription:
  engine: mlx_whisper  # mlx_whisper или whisper_cpp
  mlx_whisper:
    # Модель MLX (автоматически скачивается при первом использовании)
    # Доступные модели: mlx-community/whisper-tiny, whisper-small, whisper-medium, whisper-large-v3
    model_name: "mlx-community/whisper-large-v3"  # Максимальная точность для M4 с 128GB RAM
    language: "ru"
    temperature: 0.0
    beam_size: 5
    best_of: 5
    no_speech_threshold: 0.6
    compression_ratio_threshold: 2.4
  whisper_cpp:
    # Путь к бинарнику whisper (относительно проекта или абсолютный)
    # Только для fallback - MLX Whisper используется по умолчанию
    binary_path: "./whisper.cpp/build/bin/whisper-cli"
    # Путь к модели (Large V3 Q5_0 квантизация - максимальная точность для M4)
    model_path: "./models/ggml-large-v3-q5_0.bin"
    # ⭐ Core ML для M4 (Neural Engine) - рекомендуется включить
    use_coreml: true
    # ⭐ Metal для GPU ускорения
    use_metal: true
    # Количество потоков (8 для M4 Max - можно использовать больше потоков)
    threads: 8
    # Язык
    language: "ru"
    # Параметры качества
    temperature: 0.0
    beam_size: 5
    best_of: 5
    patience: 1.0
    # Дополнительные параметры
    no_speech_threshold: 0.6
    compression_ratio_threshold: 2.4

# Аудио
audio:
  sample_rate: 16000
  channels: 1
  device_index: null  # null = default microphone
  chunk_size: 1024
  max_recording_duration: 3600  # 1 час

# UI и управление
ui:
  auto_paste_enabled: true
  auto_paste_method: cgevent  # cgevent или clipboard
  hotkey: "option+space"      # Option+Space для toggle

menu_bar:
  icon_idle: "🎤"
  icon_recording: "🔴"
  show_status: true

# Постобработка текста (опционально)
text_processing:
  enabled: false
  # Можно добавить позже: punctuation, vocabulary, debloat

# Производительность
performance:
  use_neural_engine: true
  max_concurrent_tasks: 2  # Можно больше для M4 с большим объемом RAM
  memory_limit_mb: 32768  # 32GB для M4 (128GB RAM) - можно использовать больше памяти

# Логирование
logging:
  level: INFO  # INFO для нормальной работы, DEBUG для диагностики
  format: "%(asctime)s %(levelname)s %(name)s %(message)s"
  file: null  # null = только консоль

