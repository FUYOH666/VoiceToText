# VTT-MLX-M4 Configuration Example
# Скопируйте этот файл в .env и настройте по необходимости

# Переопределения конфигурации через ENV (опционально)
# Формат: VTT2_<SECTION>_<SUBSECTION>_<KEY>=<VALUE>
# Примеры:
# VTT2_TRANSCRIPTION_MLX_WHISPER_MODEL_NAME=mlx-community/whisper-large-v3
# VTT2_TRANSCRIPTION_MLX_WHISPER_BATCH_SIZE=6
# VTT2_AUDIO_MAX_RECORDING_DURATION=7200
# VTT2_PERFORMANCE_MEMORY_LIMIT_MB=16384

