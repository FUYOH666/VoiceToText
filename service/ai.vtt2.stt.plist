<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  VTTv2 Local STT HTTP API LaunchAgent template.
  Owns mlx_whisper. Menubar (ai.vtt2) is a thin client.
  Placeholders resolved by `python src/vtt2/main.py --install`.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>ai.vtt2.stt</string>

    <key>ProgramArguments</key>
    <array>
        <string>__UV_PATH__</string>
        <string>run</string>
        <string>python</string>
        <string>src/vtt2/main.py</string>
        <string>--serve-stt</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__PROJECT_DIR__</string>

    <key>RunAtLoad</key>
    <true/>

    <key>KeepAlive</key>
    <dict>
        <key>SuccessfulExit</key>
        <false/>
    </dict>

    <key>ThrottleInterval</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/Library/Logs/vtt2/stt.stdout.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/Library/Logs/vtt2/stt.stderr.log</string>

__ENV_VARS_XML__
</dict>
</plist>
